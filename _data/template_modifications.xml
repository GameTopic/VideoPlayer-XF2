<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="PAGE_CONTAINER" modification_key="tylVideoPlayer_assets" description="Load the bundled player assets." execution_order="10" enabled="1" action="str_replace"><find><![CDATA[<xf:set var="$siteName" value="{$xf.options.boardTitle}" />]]></find><replace><![CDATA[$0
<xf:include template="tyl_video_player_assets" />]]></replace></modification>
  <modification type="public" template="PAGE_CONTAINER" modification_key="tylVideoPlayer_config" description="Expose phrase-backed player preferences." execution_order="10" enabled="1" action="str_replace"><find><![CDATA[<body data-template="{$template}">]]></find><replace><![CDATA[$0
<xf:include template="tyl_video_player_config" />]]></replace></modification>
  <modification type="public" template="bb_code_tag_attach" modification_key="tylVideoPlayer_video" description="Enhance authorized full-size attachment video." execution_order="10" enabled="1" action="str_replace"><find><![CDATA[data-xf-init="video-init"]]></find><replace><![CDATA[$0<xf:if is="$xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_video"> preload="none" data-tyl-player-attachment="video" data-source-type="{$xf.app.inlineVideoTypes.{$attachment.extension}}" title="{$attachment.filename}"</xf:if>]]></replace></modification>
  <modification type="public" template="bb_code_tag_attach" modification_key="tylVideoPlayer_audio" description="Enhance authorized full-size attachment audio." execution_order="10" enabled="1" action="str_replace"><find><![CDATA[<audio controls]]></find><replace><![CDATA[$0<xf:if is="$xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_audio"> preload="none" data-tyl-player-attachment="audio" data-source-type="{$xf.app.inlineAudioTypes.{$attachment.extension}}" title="{$attachment.filename}"</xf:if>]]></replace></modification>
  <modification type="public" template="_media_site_embed_youtube" modification_key="tylVideoPlayer_youtube" description="Enhance native YouTube videos and playlists while retaining consent." execution_order="10" enabled="1" action="str_replace"><find><![CDATA[<iframe src=]]></find><replace><![CDATA[<iframe data-xf-init="{{ ($xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_youtube) ? 'tyl-video-player' : '' }}" data-media-type="youtube" data-src="https://www.youtube-nocookie.com/embed/{$id}{{ $start ? '?t=' . $start : '' }}{{ $list ? ($start ? '&list=' : '?list=') . $list : '' }}" data-playlist="{$list}" data-start="{$start}" title="{{ phrase('tyl_video_player_playback')|for_attr }}" data-tyl-fallback-title="{{ phrase('tyl_video_player_playback')|for_attr }}" src=]]></replace></modification>
  <modification type="public" template="xfmg_media_view_macros" modification_key="tylVideoPlayer_xfmg_video" description="Mark authorized Media Gallery video playback for the selected player." execution_order="30" enabled="1" action="str_replace"><find><![CDATA[data-video-type="video"]]></find><replace><![CDATA[$0<xf:if is="$xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_video"> data-tyl-gallery-player="video" title="{$mediaItem.title}"</xf:if>]]></replace></modification>
  <modification type="public" template="PAGE_CONTAINER" modification_key="n97_video_player_copyright_branding" execution_order="10" enabled="1" action="str_replace" description="XenShop copyright branding.">
    <find><![CDATA[{{ phrase('extra_copyright') }}]]></find>
    <replace><![CDATA[$0<xf:include template="n97_video_player_copyright_branding" />]]></replace>
  </modification>
  <modification type="public" template="xfmg_media_view_macros" modification_key="tylVideoPlayer_xfmg_audio" description="Enhance authorized Media Gallery audio playback with native URLs and posters." execution_order="30" enabled="1" action="str_replace"><find><![CDATA[data-video-type="audio"]]></find><replace><![CDATA[data-video-type="audio"<xf:if is="$xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_audio"> data-tyl-gallery-player="audio" title="{$mediaItem.title}"</xf:if>]]></replace></modification>
  <modification type="public" template="xfmg_media_lightbox_view" modification_key="tylVideoPlayer_xfmg_lightbox" description="Enhance authorized Media Gallery audio/video lightboxes, including albums." execution_order="30" enabled="1" action="str_replace"><find><![CDATA[class="fancybox-video"]]></find><replace><![CDATA[$0<xf:if is="$xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && (($mediaItem.media_type == 'audio' && $xf.options.tylVideoPlayer_audio) || ($mediaItem.media_type == 'video' && $xf.options.tylVideoPlayer_video))"> data-tyl-gallery-player="{$mediaItem.media_type}" title="{$mediaItem.title}"</xf:if>]]></replace></modification>
  <modification type="public" template="bb_code_tag_attach" modification_key="tylVideoPlayer_video_init" description="Select the video initializer after independent attachment modifiers have matched." execution_order="30" enabled="1" action="str_replace"><find><![CDATA[data-xf-init="video-init]]></find><replace><![CDATA[data-xf-init="{{ ($xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && $xf.options.tylVideoPlayer_video) ? 'tyl-video-player' : 'video-init' }}]]></replace></modification>

  <modification type="public" template="attachment_macros" modification_key="tylVideoPlayer_attachment_lightbox_setup" description="Prepare native lightbox support for authorized audio/video attachment previews." execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[<li class="file file--linked">]]></find>
    <replace><![CDATA[$0
<xf:set var="$tylMediaLightbox" value="{{ $canView && $xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && (($attachment.is_audio && $xf.options.tylVideoPlayer_audio) || ($attachment.is_video && $xf.options.tylVideoPlayer_video)) }}" />
<xf:if is="$tylMediaLightbox"><xf:macro id="lightbox_macros::setup" arg-canViewAttachments="{$canView}" /></xf:if>]]></replace>
  </modification>

  <modification type="public" template="attachment_macros" modification_key="tylVideoPlayer_attachment_lightbox_preview" description="Open eligible media preview links through the native lightbox." execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[class="file-preview"]]></find>
    <replace><![CDATA[class="file-preview{{ $tylMediaLightbox ? ' js-lbImage' : '' }}"<xf:if is="$tylMediaLightbox"> data-type="html5video" data-video-format="{{ $attachment.is_audio ? $xf.app.inlineAudioTypes.{$attachment.extension} : $xf.app.inlineVideoTypes.{$attachment.extension} }}" data-video-autoplay="false" data-caption="{{ ($attachment.is_audio ? phrase('tyl_video_player_audio') : phrase('tyl_video_player_playback'))|for_attr }}" data-tyl-player-lightbox="{{ $attachment.is_audio ? 'audio' : 'video' }}" data-ta-video-ad-content-type="{$attachment.content_type}" title="{$attachment.filename}"</xf:if>]]></replace>
  </modification>

  <modification type="public" template="attachment_macros" modification_key="tylVideoPlayer_attachment_lightbox_thumbnail" description="Preserve native image thumbnails while opening eligible audio/video media." execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[data-type="{{ $canView ? 'image' : '' }}"]]></find>
    <replace><![CDATA[data-type="{{ $tylMediaLightbox ? 'html5video' : ($canView ? 'image' : '') }}"<xf:if is="$tylMediaLightbox"> data-video-format="{{ $attachment.is_audio ? $xf.app.inlineAudioTypes.{$attachment.extension} : $xf.app.inlineVideoTypes.{$attachment.extension} }}" data-video-autoplay="false" data-caption="{{ ($attachment.is_audio ? phrase('tyl_video_player_audio') : phrase('tyl_video_player_playback'))|for_attr }}" data-tyl-player-lightbox="{{ $attachment.is_audio ? 'audio' : 'video' }}" data-ta-video-ad-content-type="{$attachment.content_type}" title="{$attachment.filename}"</xf:if>]]></replace>
  </modification>

  <modification type="public" template="bb_code_tag_attach" modification_key="tylVideoPlayer_attachment_lightbox_link" description="Open authorized non-full-size audio/video attachments in the native lightbox." execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[<xf:elseif is="!$attachment.has_thumbnail" /><xf:trim>]]></find>
    <replace><![CDATA[<xf:elseif is="!$full && !$noLightbox && $canView && $xf.options.tylVideoPlayer_enabled && ($xf.options.tylVideoPlayer_engine == 'vidstack' || $xf.options.tylVideoPlayer_engine == 'videojs10') && (($attachment.is_audio && $xf.options.tylVideoPlayer_audio) || ($attachment.is_video && $xf.options.tylVideoPlayer_video))" /><xf:trim>
<xf:macro id="lightbox_macros::setup" arg-canViewAttachments="{$canView}" />
<a href="{{ link('full:attachments', $attachment, {'hash': $attachment.temp_hash}) }}" target="_blank" class="js-lbImage" data-type="html5video" data-video-format="{{ $attachment.is_audio ? $xf.app.inlineAudioTypes.{$attachment.extension} : $xf.app.inlineVideoTypes.{$attachment.extension} }}" data-video-autoplay="false" data-caption="{{ ($attachment.is_audio ? phrase('tyl_video_player_audio') : phrase('tyl_video_player_playback'))|for_attr }}" data-tyl-player-lightbox="{{ $attachment.is_audio ? 'audio' : 'video' }}" data-ta-video-ad-content-type="{$attachment.content_type}" title="{$attachment.filename}"><xf:if is="$attachment.has_thumbnail"><img src="{$attachment.thumbnail_url_full}"
    srcset="{{ $attachment.has_retina_thumbnail ? $attachment.retina_thumbnail_url_full . ' 2x' : '' }}"
    class="bbImage {$alignClass}" style="{$styleAttr}" alt="{$alt}" title="{$alt}"
    width="{$attachment.thumbnail_width}" height="{$attachment.thumbnail_height}" loading="lazy" /><xf:else />{{ phrase('view_attachment_x', {'name': $attachment.filename}) }}</xf:if></a>
</xf:trim>$0]]></replace>
  </modification>
</template_modifications>
